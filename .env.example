# Copy to .env.local for local development. Never commit real values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hrms?schema=public"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: only allow Google accounts from this Workspace domain
AUTH_GOOGLE_HD=""
# Demo sign-in with password demo123 for the seeded profiles. Never enable in production.
AUTH_DEMO="true"

# 32-byte keys, base64. Generate with: openssl rand -base64 32
FACE_TEMPLATE_KEY=""
APP_ENCRYPTION_KEY=""

# Cron jobs (Vercel Cron sends: Authorization: Bearer $CRON_SECRET)
CRON_SECRET=""

# Transactional email (Resend). Without a key, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Silver Touch HRMS <hrms@example.com>"
APP_BASE_URL="http://localhost:3000"

# Receipt storage: "local" (dev, ./.data/receipts) or "supabase"
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="receipts"

# Google Sheets backup (service account with edit access to the sheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID="1bUB7J6GZZHG7sVV68fCjJ5h07TShwe10hIdWK7L_uEc"
